# Copy this file to .env and fill in your values
# NEVER commit .env to git

# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/?retryWrites=true&w=majority

# MongoDB database name (optional, defaults to blood_directory)
MONGODB_DB=blood_directory

# Admin credentials — set strong values before deploying
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_to_a_strong_password

# HMAC signing secret for admin session tokens — set a long random string
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_TOKEN_SECRET=replace_with_a_long_random_secret_string
